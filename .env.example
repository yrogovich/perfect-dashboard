# Copy to .env.local (and add the same variables in Vercel project settings).

# Page the Core Web Vitals card analyzes.
PSI_URL=https://payloadcms.com

# Free key from Google Cloud (enable the "PageSpeed Insights API").
# Without it, every caller shares one daily quota that is often used up,
# and the card shows a "no live results" notice instead of data.
PAGESPEED_API_KEY=
